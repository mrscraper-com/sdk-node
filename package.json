{
  "name": "@mrscraper/sdk",
  "version": "4.0.0",
  "description": "Official Node.js SDK for MrScraper HTML, Markdown, screenshots, extraction, sitemap, brand scraping, web search, and account status.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "mrscraper.jpeg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "npm run build && npm run test:types && node --test tests/*.test.mjs",
    "test:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck tests/types.test.ts"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mrscraper",
    "scraper",
    "web-scraping",
    "scraping",
    "sdk",
    "api-client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrscraper-com/sdk-node.git"
  },
  "homepage": "https://mrscraper.com"
}
